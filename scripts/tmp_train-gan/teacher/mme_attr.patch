+def save_attr(path: Path, attr: dict, outcome: str, task_goal: str) -> None:
+    """robomme-large-attr: one rollout -> npz. front / wrist [F] JPEG (q95) bytes, state [F, 8], action [F-1-exec_start, 8]
+    (joint space), exec_start_idx (frames before it are the conditioning video), and per policy call: step_idx [C]
+    (current frame), mem_frames [C, 32] (sampled frame indices, right-padded), mem_valid [C, 32], mem_attn [C, M, 512]
+    (MemoryAttention probs per call, UNORDERED across layers / denoising steps, mean over heads + query tokens),
+    mem_attn_qlen [C, M], cos_siglip / cos_memtok [C, 31] (adjacent memory frames: SigLIP embedding / memory-encoder
+    output cosine), causal_top / causal_rand [C] (mean |delta action|, normalized, masking the top-4 attended / 4 random
+    frames; NaN on unchecked calls), causal_top_frames / causal_rand_frames [C, 4] (slot indices; -1 if unchecked),
+    siglip_frame [C, 32, 2048] / memtok_frame [C, 32, 1024] float16 (raw per-frame embeddings; center before cosine),
+    loo_replace_dact [C, 32] (mean |delta action| replacing that frame's SigLIP tokens with the call's frame mean;
+    NaN on unchecked calls and padded frames)."""
+    import cv2
+    path.parent.mkdir(parents=True, exist_ok=True)
+    jpeg = lambda frames: np.array([cv2.imencode(".jpg", f[..., ::-1], [cv2.IMWRITE_JPEG_QUALITY, 95])[1] for f in frames],
+                                   dtype=object)
+    calls = {k: np.stack([c[k] for c in attr["calls"]]) for k in attr["calls"][0]} if attr["calls"] else {}
+    np.savez(path, front=jpeg(attr["front"]), wrist=jpeg(attr["wrist"]), state=np.stack(attr["state"]),
+             action=np.stack(attr["action"]) if attr["action"] else np.zeros((0, 8)),
+             exec_start_idx=attr["exec_start_idx"], outcome=outcome, task_goal=task_goal, **calls)
 
 
