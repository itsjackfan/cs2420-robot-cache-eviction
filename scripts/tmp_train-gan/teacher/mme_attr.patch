+    def _attribution(self, raw_inputs: dict, sample_rng, actions) -> dict:
+        """robomme-large-attr (+ large-attr-margin) per call: memory frames (absolute indices, right-padded) and valid
+        mask, MemoryAttention probs, adjacent-frame cosine on SigLIP embeddings and memory-encoder outputs, and every
