+        F = self.config.budget // self.config.token_per_image
+        cos = lambda e_FD: np.sum(e_FD[:-1] * e_FD[1:], -1) / (
+            np.linalg.norm(e_FD[:-1], axis=-1) * np.linalg.norm(e_FD[1:], axis=-1) + 1e-8)
+        mem_attn_MS = np.stack([p[0] for _, p in history_gemma.MEM_ATTN])
