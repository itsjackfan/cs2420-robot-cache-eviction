export WANDB_API_KEY=<service account key>
export RCE_OUT_ROOT=/n/netscratch/<lab>/Lab/<user>/rce/runs   # run outputs: <root>/<exp>/<ablation>/
export RCE_DATA_DIR=/n/netscratch/<lab>/Lab/<user>/rce/data    # LIBERO HDF5 cache, shared by all runs
export LIBERO_ROOT=/n/holylabs/<lab>/Lab/<user>/LIBERO        # clone made by cluster/setup.sh
