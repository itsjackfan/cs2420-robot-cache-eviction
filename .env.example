# Cluster values: the post-commit hook syncs this file to FASRC. Locally, set LIBERO_ROOT (and MUJOCO_GL=cgl on macOS) in your shell.
export WANDB_API_KEY=<service account key>
export RCE_OUT_ROOT=/n/netscratch/<lab>/Lab/<user>/rce/runs   # run outputs: <root>/<exp>/<ablation>/ (netscratch purges after 90 days)
export RCE_DATA_DIR=/n/holylabs/<lab>/Lab/<user>/rce/data      # LIBERO HDF5 cache, shared by all runs
export LIBERO_ROOT=/n/holylabs/<lab>/Lab/<user>/LIBERO        # clone made by cluster/setup.sh
export HF_HOME=/n/holylabs/<lab>/Lab/<user>/hf                # model cache (SmolVLA ~1.2 GB, BERT)
